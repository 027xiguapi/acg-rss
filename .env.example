# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:fang123456@localhost:5432/torrent_hub

# Remote production database to sync from (used by `pnpm db:pull-remote`)
REMOTE_DATABASE_URL=

# Secret used to encrypt/sign Auth.js session JWTs (any long random string; change it!)
AUTH_SECRET=replace-with-a-long-random-string

# Trust the Host header (self-hosted / Docker / reverse proxy setups)
AUTH_TRUST_HOST=true

# Secret protecting the cron fetch endpoint (/api/cron/fetch)
CRON_SECRET=

# OAuth login (optional — the login buttons only appear when both keys of a
# provider are set). Create them at:
#   GitHub: https://github.com/settings/developers
#   Google: https://console.cloud.google.com/apis/credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Cloudflare R2 object storage for cover image uploads (optional).
# Create an API token with "Object Read & Write" for the bucket:
#   https://dash.cloudflare.com/<account>/r2/api-tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL the uploaded files are served from (custom domain or
# a public r2.dev bucket URL, e.g. https://cdn.example.com). No trailing slash.
R2_PUBLIC_URL=
