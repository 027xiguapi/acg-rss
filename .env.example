# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/torrent_hub

# Secret used to sign session JWTs (any long random string; change it!)
AUTH_SECRET=replace-with-a-long-random-string

# Secret used to encrypt stored credentials (AES-256-GCM; change it!)
ENCRYPTION_KEY=replace-with-a-long-random-string

# Enable the built-in background scheduler (RSS refresh / matcher / qB sync)
JOBS_ENABLED=true

# Optional: RSS fetch interval in minutes when the feed has no custom interval
# RSS_DEFAULT_INTERVAL_MINUTES=5
