# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:fang123456@localhost:5432/torrent_hub

# Secret used to encrypt/sign Auth.js session JWTs (any long random string; change it!)
AUTH_SECRET=replace-with-a-long-random-string

# Trust the Host header (self-hosted / Docker / reverse proxy setups)
AUTH_TRUST_HOST=true

# Secret protecting the cron fetch endpoint (/api/cron/fetch)
CRON_SECRET=

# OAuth login (optional — the login buttons only appear when both keys of a
# provider are set). Create them at:
#   GitHub: https://github.com/settings/developers
#   Google: https://console.cloud.google.com/apis/credentials
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
